{
  "name": "local-proxy",
  "type": "module",
  "version": "3.0.0",
  "scripts": {
    "api-b2b": "node index.ts --site=b2b-api",
    "api-chums": "node index.ts --site=api-chums",
    "api-images": "node index.ts --site=api-images",
    "api-operations": "node index.ts --site=api-operations",
    "api-partners": "node index.ts --site=api-partners",
    "api-payroll": "node index.ts --site=api-payroll",
    "api-sage": "node index.ts --site=api-sage",
    "api-sage-sales": "node index.ts --site=api-sage-sales",
    "api-sales": "node index.ts --site=api-sales",
    "api-shopify": "node index.ts --site=api-shopify",
    "api-timeclock": "node index.ts --site=api-timeclock",
    "api-user": "node index.ts --site=api-user",
    "b2b": "node index.ts --site=b2b --port=80",
    "b2b:local": "node index.ts --site=b2b --port=80 --local=b2b-api",
    "b2b-api": "node index.ts --site=b2b-api",
    "b2b-server": "node index.ts --site=b2b-server --port=8081",
    "dev:local": "node index.ts --site=dev:local --port=80",
    "intranet": "node index.ts --site=intranet --port=8081",
    "inventory-entry": "node index.ts --site=inventory-entry --port=8081",
    "intranet-80": "node index.ts --site=intranet --port=80"
  },
  "dependencies": {
    "@tsconfig/node22": "^22.0.0",
    "body-parser": "^2.2.0",
    "command-line-args": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.5",
    "debug": "^4.3.4",
    "dotenv": "^18.0.0",
    "express": "^5.1.0",
    "express-http-proxy": "^2.1.1",
    "http-proxy": "^1.18.1",
    "http-proxy-rules": "^1.1.3"
  },
  "nodemonConfig": {
    "delay": 1500,
    "ignore": [
      "**/node_modules/*"
    ]
  },
  "devDependencies": {
    "@types/command-line-args": "^5.2.3",
    "@types/compression": "^1.7.5",
    "@types/debug": "^4.1.12",
    "@types/express-http-proxy": "^1.6.6",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2"
  }
}
